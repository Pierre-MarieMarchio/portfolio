*.iml
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
.history/
# VS Code: the shared settings are committed, the rest is personal.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# --- AI assistants ---------------------------------------------------------------
# Local development tools, never imposed on whoever clones this repository:
# their settings, agents, skills, hooks, memory and instruction files all stay
# on the machine of the person who chose them. Nothing here is needed to build,
# test or run the site.
# Claude Code
.claude/
CLAUDE.md
CLAUDE.local.md
**/CLAUDE.md
**/CLAUDE.local.md
